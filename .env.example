# Data provider — "mock" (par défaut, pas besoin de clé) | "football-data-org" | "api-football"
FOOTBALL_PROVIDER=mock

# Football-Data.org (gratuit, inscription sur https://www.football-data.org/client/register)
FOOTBALL_DATA_API_KEY=

# API-Football via RapidAPI (payant, à utiliser plus tard si trafic important)
RAPIDAPI_KEY=

# Supabase (gratuit, https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron — protection des routes /api/cron/*
CRON_SECRET=

# URL publique du site (pour metadata, OAuth callbacks, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Emails admin (CSV, case-insensitive). Affiche le bouton "+10000 Buts" sur /profil
# et autorise /api/admin/* pour ces utilisateurs.
# Exemple : ADMIN_EMAILS=toi@example.com,autre@example.com
ADMIN_EMAILS=

# Google Search Console — code de vérification "HTML tag" (sans la balise meta,
# juste la valeur content="..."). Requis pour publier l'écran de consentement
# OAuth en production. Récupérable sur https://search.google.com/search-console
# en ajoutant une propriété "URL prefix" et en choisissant "HTML tag".
GOOGLE_SITE_VERIFICATION=
